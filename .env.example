# ─────────────────────────────────────────────────────────────
#  이 파일을 .env.local 로 복사해 채우세요. (또는 Vercel 환경변수)
#  DB ID를 비워 두면 그 DB는 "미연결"로 표시되고,
#  해당 화면은 조회·저장이 중단됩니다. 기본값 폴백은 없습니다.
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
#  필수
# ─────────────────────────────────────────────────────────────
# notion.so/my-integrations 에서 만든 내부 통합 토큰 (secret_… / ntn_…)
NOTION_TOKEN=

# ─────────────────────────────────────────────────────────────
#  데이터베이스 5개 — 내 노션 DB의 32자리 ID
#  (노션 DB 주소 https://www.notion.so/<워크스페이스>/<DB_ID>?v=… 의 <DB_ID>)
#  각 DB에서 ··· → Connections 에 위 통합을 추가해야 API가 읽을 수 있습니다.
# ─────────────────────────────────────────────────────────────
# 캘린더 기록 — 일정 / 주간 목표 / 주간 메모 / 월간 메모
NOTION_CALENDAR_DB_ID=

# 프로젝트 · 할 일
NOTION_PROJECTS_DB_ID=

# 루틴 · 체크 기록
NOTION_ROUTINE_DB_ID=

# 일기 · 노트
NOTION_BINDER_DB_ID=

# 아카이브
NOTION_ARCHIVE_DB_ID=

# ─────────────────────────────────────────────────────────────
#  선택
# ─────────────────────────────────────────────────────────────
# 비밀번호 보호. 값을 넣으면 접속 시 비밀번호를 묻습니다. (권장)
DIARY_PASSWORD=

# 세션 서명 키. 비워 두면 DIARY_PASSWORD를 사용합니다.
# DIARY_SESSION_SECRET=
